# Docker Compose environment for ShareLab.
# Copy to .env and fill in the secrets before running `docker compose up -d`.

# Public URL the browser uses. With HTTPS termination put the https:// URL here.
APP_URL=http://localhost:8080
APP_PORT=8080

# Laravel application key: `php artisan key:generate --show`
APP_KEY=

# Signs the JWT access/refresh tokens. Use a long random value:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=10080

# Database
DB_DATABASE=sharelab
DB_USERNAME=sharelab
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Run migrations on container start; set SEED_DATABASE=1 once to load the
# demo accounts (user@user.com, manager@slab.com, owner@admin.com,
# admin@admin.com — password "password"). Do not leave seeding enabled.
RUN_MIGRATIONS=1
SEED_DATABASE=0
