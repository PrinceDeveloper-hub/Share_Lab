# ShareLab API — environment contract.
# Copy to .env for local work; in production provide the same keys through the
# host's environment variables. Never commit a filled .env.
#
# The API refuses to boot when APP_ENV=production and any of APP_KEY,
# JWT_SECRET, DB_HOST, DB_DATABASE, AUTH_COOKIE_SECURE or ALLOWED_ORIGINS is
# missing.

APP_NAME=ShareLab
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Public origin of the API. Locally Laragon serves it at
# https://sharelab-api.local; production is your own host.
APP_URL=https://sharelab-api.local
APP_TIMEZONE=UTC

# Containers should log to stderr so the platform collects the output.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Signs the JWT access/refresh tokens: openssl rand -base64 48
JWT_SECRET=
# Minutes.
JWT_TTL=15
JWT_REFRESH_TTL=10080
JWT_ACCESS_COOKIE=sharelab_access
JWT_REFRESH_COOKIE=sharelab_refresh

# HttpOnly auth cookies. Same-origin deployments can use `lax` with Secure on.
# A split deployment (SPA on Vercel) needs `none`, which browsers only accept
# together with Secure over HTTPS.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Exact SPA origins, comma separated. Scheme + host, no trailing slash and no
# wildcard (credentialed CORS forbids '*'). Used by CORS and by the
# state-changing request origin check.
ALLOWED_ORIGINS=https://share-lab.vercel.app

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sharelab
DB_USERNAME=sharelab
DB_PASSWORD=

# Create the five demo accounts on boot. Never enable this in production.
SEED_DEMO=false
# Run `php artisan migrate --force` on container start.
RUN_MIGRATIONS=1

# Private uploads (credentials, condition photos) and public resource images.
# Set both to `s3` to use object storage on a host with an ephemeral disk.
FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=public
# 4096 KB stays below the 4.5 MB body limit of hosted proxies (Vercel).
MAX_UPLOAD_KB=4096

# Optional S3-compatible object storage (MinIO, R2, Spaces, ...).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

CACHE_STORE=file
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync

# "attempts,minutes" for the login and registration rate limiters.
LOGIN_THROTTLE=10,1
REGISTER_THROTTLE=10,1
