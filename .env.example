# Docker Compose environment for the local ShareLab API stack.
# Copy to .env and fill in the blanks before `docker compose up -d --build`.
# Production uses docker-compose.prod.yml with .env.production instead.

# Public URL the browser uses to reach the API (Vite proxies /api here in dev).
APP_URL=http://localhost:8000
API_PORT=8000

# Laravel application key: `php artisan key:generate --show`
APP_KEY=

# Signs the JWT access/refresh tokens: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=10080

# Database (the compose `db` service).
DB_DATABASE=sharelab
DB_USERNAME=sharelab
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Browser origins allowed to call the API with cookies.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HttpOnly cookie flags. Local http:// needs Secure off.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Migrations run on start; seed the demo accounts only when you want them.
RUN_MIGRATIONS=1
SEED_DEMO=0

# Uncomment to expose MariaDB on the host (e.g. for `php artisan serve`).
# DB_PORT=3306
