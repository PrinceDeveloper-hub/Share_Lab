includes:
    - vendor/larastan/larastan/extension.neon
    # Pre-existing findings captured when Larastan was added. The baseline must
    # shrink, never grow: new code has to be clean.
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
    excludePaths:
        - app/Exceptions/Handler.php
    checkMissingIterableValueType: false
