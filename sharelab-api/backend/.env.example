APP_NAME=ShareLab
APP_ENV=local
APP_KEY=base64:production_key_will_be_set_here
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sharelab
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie

SANCTUM_STATEFUL_DOMAINS=localhost

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173