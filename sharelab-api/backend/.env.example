APP_NAME=ShareLab
APP_ENV=local
APP_KEY=base64:production_key_will_be_set_here
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sharelab
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie

SANCTUM_STATEFUL_DOMAINS=localhost

# JWT auth (HttpOnly cookies). Use a long random value in production.
JWT_SECRET=
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=10080

# "attempts,minutes" for the login/registration rate limiters.
# Keep 10,1 in production; end-to-end suites may raise it locally.
LOGIN_THROTTLE=10,1
REGISTER_THROTTLE=10,1
JWT_ACCESS_COOKIE=sharelab_access
JWT_REFRESH_COOKIE=sharelab_refresh
AUTH_GUARD=api

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173